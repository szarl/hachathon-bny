<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference-7890" class="- topic/topic       reference/reference ">
    <title class="- topic/title ">Caps and Floors Key Options</title>
    <shortdesc class="- topic/shortdesc ">Lists key configuration fields and tags for defining cap and floor security master records.</shortdesc>
    <refbody class="- topic/body        reference/refbody ">
        <table class="- topic/table ">
            <tgroup cols="3" class="- topic/tgroup ">
                <colspec colname="c1" colnum="1" class="- topic/colspec "/>
                <colspec colname="c2" colnum="2" class="- topic/colspec "/>
                <colspec colname="c3" colnum="3" class="- topic/colspec "/>
                <thead class="- topic/thead ">
                    <row class="- topic/row ">
                        <entry class="- topic/entry ">Field Name</entry>
                        <entry class="- topic/entry ">Tag</entry>
                        <entry class="- topic/entry ">Description</entry>
                    </row>
                </thead>
                <tbody class="- topic/tbody ">
                    <row class="- topic/row ">
                        <entry class="- topic/entry ">Processing Security Type</entry>
                        <entry class="- topic/entry ">3931</entry>
                        <entry class="- topic/entry ">Identifies the type: OPIRCA (Caps) or OPIRFL (Floors).</entry>
                    </row>
                    <row class="- topic/row ">
                        <entry class="- topic/entry ">Coupon Type Code</entry>
                        <entry class="- topic/entry ">97</entry>
                        <entry class="- topic/entry ">Type of coupon (e.g., Floating, Variable, Inverse Floater).</entry>
                    </row>
                    <row class="- topic/row ">
                        <entry class="- topic/entry ">Strike Rate</entry>
                        <entry class="- topic/entry ">11850</entry>
                        <entry class="- topic/entry ">The ceiling rate for caps or floor rate for floors.</entry>
                    </row>
                    <row class="- topic/row ">
                        <entry class="- topic/entry ">Maturity Price</entry>
                        <entry class="- topic/entry ">42</entry>
                        <entry class="- topic/entry ">Price at which security returns principal.</entry>
                    </row>
                    <row class="- topic/row ">
                        <entry class="- topic/entry ">Trading Flat</entry>
                        <entry class="- topic/entry ">3949</entry>
                        <entry class="- topic/entry ">Whether the security trades with or without interest.</entry>
                    </row>
                    <row class="- topic/row ">
                        <entry class="- topic/entry ">OID Indicator</entry>
                        <entry class="- topic/entry ">218</entry>
                        <entry class="- topic/entry ">Whether the security is OID eligible.</entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
    </refbody>
</reference>