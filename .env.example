
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_CLASSIFY_MODEL=gemini-2.0-flash
GEMINI_GENERATE_MODEL=gemini-2.0-flash
GEMINI_VALIDATE_MODEL=gemini-2.0-flash
# false | 0 | no | off = skip Agent 2 (Gemini validation). ZIP stays Agent 1 output; basic checks still run on the server.
GEMINI_AGENT2_ENABLED=true
# Optional: max AGENT_* output tokens (defaults 65536 each; clamped 4096–131072).
# GEMINI_AGENT1_MAX_OUTPUT_TOKENS=65536
# GEMINI_AGENT2_MAX_OUTPUT_TOKENS=65536
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

SUPABASE_DATABASE_PASSWORD=replace-with-supabase-database-password
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Local: point at dev:extract. On Vercel, omit to use https://$VERCEL_PROJECT_PRODUCTION_URL/api/extract
# (colocated api/extract.py). Set explicitly only if the public production alias differs.
EXTRACT_API_URL=http://127.0.0.1:8001/api/extract

# Optional: DITA Open Toolkit HTML5 — uploads a public folder preview to Supabase (`html-preview` path). Not added to the ZIP.
# Requires Java and a local DITA-OT install. Unset or false = skip (conversion still succeeds).
# DITA_OT_STRICT=true fails the job when HTML build fails (default: loose / skip on error).
DITA_OT_ENABLED=false
# DITA_OT_STRICT=false
# Absolute path to the DITA-OT *unzipped root* (must contain bin/dita or Windows bin/dita.bat).
# On Windows with Next.js, unset PATH often misses dita.bat — set DITA_OT_DIR explicitly (then restart npm run dev).
# DITA_OT_DIR=C:\tools\dita-ot

# AI HTML fallback: when DITA-OT does not publish a preview, Gemini builds one HTML page from the validated XML (figures omitted).
# Disabled if GEMINI_API_KEY is missing, or set GEMINI_AI_HTML_PREVIEW_ENABLED=false.
# GEMINI_AI_HTML_PREVIEW_ENABLED=true
# GEMINI_HTML_PREVIEW_MODEL=gemini-2.0-flash
# Output token ceiling for AI HTML preview (defaults to 65536; raise if previews truncate).
# GEMINI_HTML_PREVIEW_MAX_OUTPUT_TOKENS=65536
